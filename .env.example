# Copy to .env.local and fill in. Never commit real values.

# Public settings (visible in the browser)
NEXT_PUBLIC_BRAND_NAME=BOCHKE
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Tag Manager container id (GTM-...). Leave empty for no Google tags (local dev, tests).
NEXT_PUBLIC_GTM_ID=

# Server only
MONGODB_URI=

# Admin (needed only to use /admin): the email and password you type on /en/admin/login. Server only.
# Password: at least 8 characters, no "$" (Next.js reads "$name" in .env as a variable).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# At least 32 random characters, for example: openssl rand -hex 32
SESSION_SECRET=

# Never set in production. Only the E2E server sets RATE_LIMIT_DISABLED=true (all tests share one address).
# RATE_LIMIT_DISABLED=false
