# Copy to .env.local and fill in. Never commit real values.

# Public settings (visible in the browser)
NEXT_PUBLIC_BRAND_NAME=Brand
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only
MONGODB_URI=

# Admin (needed only to use /admin). Create the hash with: npm run hash-password -- "your password"
# In a .env file write every "$" of the hash as "\$" (Next.js would read "$name" as a variable).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# At least 32 random characters, for example: openssl rand -hex 32
SESSION_SECRET=
